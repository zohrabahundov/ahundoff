# ==========================================================================
# AHUNDOFF.RU - Исправленная конфигурация для Timeweb (без циклов редиректов)
# Версия 21.11.2026: + PHP внутри .html (общие шаблоны templates/ + словари lang/) + защита partials/templates/lang/
# ==========================================================================

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # !!! ЗАКОММЕНТИРОВАНО: Редирект на HTTPS через .htaccess на Timeweb
    # часто вызывает бесконечный цикл. HTTPS включается в панели хостинга.
    # RewriteCond %{HTTPS} off
    # RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Убираем www (редирект на чистый домен)
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^(.*)$ https://%1/$1 [L,R=301]

    # Аудит 21.11.2026: /index.html -> / (устраняем дубль главной для SEO)
    RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
    RewriteRule ^index\.html$ / [L,R=301]

    # Блокируем скрытые файлы и папки, КРОМЕ .well-known (нужен для Let's Encrypt и security.txt)
    RewriteCond %{REQUEST_URI} !^/\.well-known/ [NC]
    RewriteRule (^\.|/\.) - [F]

    # Блокируем прямой доступ к папке logs
    RewriteRule ^logs/ - [F,L]

    # === ДОБАВЛЕНО 21.11.2026: блокируем прямой доступ к фрагментам шаблонов ===
    RewriteRule ^partials/ - [F,L]
    # Общие шаблоны и словари не должны открываться напрямую
    RewriteRule ^templates/ - [F,L]
    RewriteRule ^lang/ - [F,L]
    RewriteRule ^i18n\.php$ - [F,L]
</IfModule>

# ==========================================================================
# === ДОБАВЛЕНО 21.11.2026: PHP внутри .html — для шаблонов header/footer ===
# ==========================================================================
RemoveHandler .html .htm
AddType application/x-httpd-php .php .html .htm
# Если test-php.html отдаёт сырой код или скачивается — закомментируйте две
# строки выше и раскомментируйте строку ниже:
# AddHandler application/x-httpd-php .html .htm

# Защита конкретных файлов (синтаксис Apache 2.4)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<FilesMatch "\.(log|json|bak|backup|old|env)$">
    Require all denied
</FilesMatch>

# send.php — разрешаем ТОЛЬКО POST-запросы (защита формы)
<Files "send.php">
    <LimitExcept POST>
        Require all denied
    </LimitExcept>
</Files>

# Запрет просмотра содержимого папок
Options -Indexes

# Аудит 21.11.2026: брендированная страница 404 вместо дефолтной Apache
ErrorDocument 404 /404.html

# Сжатие данных (ускоряет загрузку)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Кэширование на стороне браузера
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
    # Аудит 21.11.2026: убран ExpiresByType text/html — он создавал ВТОРОЙ заголовок
    # Cache-Control (max-age=0) поверх no-cache ниже. HTML кэшируется только через Header.
</IfModule>

# favicon — вне годового кэша
<FilesMatch "^favicon\.(svg|ico)$">
    ExpiresActive Off
    Header unset Expires
    Header unset Cache-Control
    Header always unset Cache-Control
    Header always set Cache-Control "no-cache, must-revalidate"
</FilesMatch>

# Кодировка по умолчанию
AddDefaultCharset UTF-8

# ==========================================================================
# SECURITY HEADERS (заголовки безопасности)
# ==========================================================================
<IfModule mod_headers.c>
    # HSTS — принудительный HTTPS на 1 год
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

    # Защита от clickjacking (запрет встраивания в iframe)
    Header always set X-Frame-Options "SAMEORIGIN"

    # Защита от MIME-sniffing
    Header always set X-Content-Type-Options "nosniff"

    # Контроль referrer-информации
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Ограничение доступа к API браузера
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"

    # Content Security Policy (защита от XSS).
    # Аудит 21.11.2026: убраны 'unsafe-eval' (Metrika его не использует) и cdn.jsdelivr.net
    # (QR-библиотека теперь self-hosted); img-src сужен; добавлены object-src 'none' и
    # upgrade-insecure-requests. Шрифты self-hosted — Google больше не нужен.
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://mc.yandex.ru; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https://mc.yandex.ru; connect-src 'self' https://mc.yandex.ru; object-src 'none'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests"

    # Убираем версию сервера
    Header unset X-Powered-By
</IfModule>

# PATCH 2026-11-21-2: HTML всегда перепроверяется сервером (no-cache).
# Кэшируются только версионированные JS/CSS/изображения.
<FilesMatch "\.(html|htm)$">
    Header always set Cache-Control "no-cache, must-revalidate"
</FilesMatch>
